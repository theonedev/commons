// Unicode 🙂 and misleading braces }.
[[s:Example]]namespace [[p:Example]]Example[[/p:Example]] {
	[[s:Worker]]class [[p:Worker]]Worker[[/p:Worker]] {
		[[s:first]]void [[p:first]]first[[/p:first]](
			int value) { if (value) { value++; } }[[/s:first]] /* 🙂 */ [[s:second]]void [[p:second]]second[[/p:second]]() {}[[/s:second]]
	}[[/s:Worker]];
}[[/s:Example]]
[[s:RUN]]#define [[p:RUN]]RUN[[/p:RUN]](x) \
	do { \
		x++; \
	} while (0)[[/s:RUN]]
[[s:Record]]typedef struct {
	int value;
} [[p:Record]]Record[[/p:Record]];[[/s:Record]]
